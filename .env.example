# Upstream provider keys. Only define the providers you use.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional client-facing bearer token. Required when binding outside loopback.
AGENT_OPENCODEX_CLIENT_KEY=change-me

# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Agent OpenCodex
